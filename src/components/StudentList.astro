---
import type { Member } from '../data/lab';
interface Props {
  students: Member[];
  labelledBy: string;
}
const { students, labelledBy } = Astro.props;
---

<div class="student-table-wrap">
  <table class="student-table" aria-labelledby={labelledBy}>
    <thead>
      <tr>
        <th scope="col">Admission Year</th>
        <th scope="col">Name</th>
        <th scope="col">Program</th>
        <th scope="col">Affiliation</th>
      </tr>
    </thead>
    <tbody>
      {students.map((student) => (
        <tr id={student.id}>
          <td>{student.admissionYear || '—'}</td>
          <th scope="row">{student.name}</th>
          <td>
            {student.program ? (
              <span class="student-program-tag">
                {student.program === "MOT Master's Program" ? (
                  <><span>MOT</span>{' '}<span>Master's Program</span></>
                ) : student.program}
              </span>
            ) : '—'}
          </td>
          <td>{student.organization || '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .student-table-wrap {
    overflow-x: auto;
  }
  .student-table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 0.8125rem;
    text-align: left;
  }
  th, td {
    padding: 12px 12px 12px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  th:last-child, td:last-child {
    padding-right: 0;
    overflow-wrap: anywhere;
  }
  thead th {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  thead th:nth-child(1) {
    width: 90px;
  }
  thead th:nth-child(2) {
    width: 144px;
  }
  thead th:nth-child(3) {
    width: 132px;
  }
  .student-program-tag {
    display: inline-block;
    max-width: 100%;
    padding: 3px 8px;
    border-radius: 4px;
    background: #e9f0fa;
    color: #365b8c;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.45;
    vertical-align: top;
  }
  .student-program-tag > span {
    display: block;
    white-space: nowrap;
  }
  tbody th {
    font-weight: 500;
  }
  td {
    color: var(--muted);
  }
</style>
