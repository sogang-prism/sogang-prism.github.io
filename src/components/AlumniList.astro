---
import type { Alumnus } from '../data/lab';
interface Props {
  alumni: Alumnus[];
}
const { alumni } = Astro.props;
---

<div class="alumni-table-wrap">
  <table class="alumni-table" aria-labelledby="alumni">
    <thead>
      <tr>
        <th scope="col">Graduation Year</th>
        <th scope="col">Name</th>
        <th scope="col">Program</th>
        <th scope="col">Project / Thesis Title</th>
      </tr>
    </thead>
    <tbody>
      {
        alumni.length > 0 ? (
          alumni.map((person) => (
            <tr id={person.id}>
              <td>{person.year || '—'}</td>
              <th scope="row">{person.name}</th>
              <td>
                {person.course ? (
                  <span class="alumni-program-tag">
                    {person.course === "MOT Master's Program" ? (
                      <><span>MOT</span>{' '}<span>Master's Program</span></>
                    ) : person.course}
                  </span>
                ) : (
                  '—'
                )}
              </td>
              <td class="alumni-project"><span class="alumni-project-english">{person.project || '—'}</span>{person.projectKorean && <small class="alumni-project-korean" lang="ko">{person.projectKorean}</small>}</td>
            </tr>
          ))
        ) : (
          <tr>
            <td class="people-empty" colspan="4">
              Alumni information will be added soon.
            </td>
          </tr>
        )
      }
    </tbody>
  </table>
</div>

<style>
  .alumni-project-english { color: #263b53; font-size: 0.78125rem; line-height: 1.5; }
  .alumni-project-korean { display: block; margin-top: 3px; color: #6b7787; font-size: 0.6875rem; font-weight: 400; line-height: 1.5; word-break: keep-all; }
</style>
