---
import type { Alumnus } from '../data/lab';
interface Props {
  alumni: Alumnus[];
}
const { alumni } = Astro.props;
---

<div class="alumni-table-wrap">
  <table class="alumni-table" aria-labelledby="alumni">
    <thead>
      <tr>
        <th scope="col">Graduation Year</th>
        <th scope="col">Name</th>
        <th scope="col">Program</th>
        <th scope="col">Project / Thesis Title</th>
      </tr>
    </thead>
    <tbody>
      {
        alumni.length > 0 ? (
          alumni.map((person) => (
            <tr id={person.id}>
              <td>{person.year || '—'}</td>
              <th scope="row">{person.name}</th>
              <td>
                {person.course ? (
                  <span class="alumni-program-tag">
                    {person.course === "MOT Master's Program" ? (
                      <><span>MOT</span>{' '}<span>Master's Program</span></>
                    ) : person.course}
                  </span>
                ) : (
                  '—'
                )}
              </td>
              <td>{person.project || '—'}{person.projectKorean && <small class="alumni-project-korean">{person.projectKorean}</small>}</td>
            </tr>
          ))
        ) : (
          <tr>
            <td class="people-empty" colspan="4">
              Alumni information will be added soon.
            </td>
          </tr>
        )
      }
    </tbody>
  </table>
</div>

<style>
  .alumni-project-korean { display: block; margin-top: 4px; font-size: 0.75rem; line-height: 1.5; }
</style>
