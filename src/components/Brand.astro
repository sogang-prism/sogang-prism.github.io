---
import { lab } from '../data/lab';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class:list={['brand', { 'brand-compact': compact }]}>
  <svg class="brand-mark" viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <g>
      <g fill="#9bb2d1"
        ><circle cx="40" cy="37" r="6"></circle><circle cx="30" cy="57" r="6"
        ></circle><circle cx="20" cy="77" r="6"></circle></g
      >
      <g fill="#bbc8dc"
        ><circle cx="50" cy="57" r="6"></circle><circle cx="40" cy="77" r="6"
        ></circle><circle cx="60" cy="77" r="6"></circle></g
      >
      <circle cx="50" cy="17" r="6" fill="#a4c4ef"></circle>
      <circle cx="60" cy="37" r="6" fill="#7ba1df"></circle>
      <circle cx="70" cy="57" r="6" fill="#4c79ca"></circle>
      <circle cx="80" cy="77" r="6" fill="#315cca"></circle>
    </g>
  </svg>
  <span class="brand-wordmark">
    <span>{lab.name}</span>
    {!compact && <span class="brand-full-name">{lab.fullName}</span>}
  </span>
</span>
