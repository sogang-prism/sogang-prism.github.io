---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { sitePath } from '../lib/links';
---

<Layout title="Page not found" active="" noindex>
  <section class="error-page">
    <p class="eyebrow">404 / Page not found</p><h1>
      This page isn't here<span class="title-dot">.</span>
    </h1><p>
      The link may have changed. You can return to the lab homepage below.
    </p><a class="button" href={sitePath()}>Back to the lab <Arrow /></a>
  </section>
</Layout>
