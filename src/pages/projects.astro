---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
import { projects } from '../data/lab';
import { sitePath } from '../lib/links';
---

<Layout title="Projects" active="projects">
  <PageHeading number="04" title="Projects" showDot={false} />
  <div class="page-content">
    {projects.length > 0 ? (
      <div class="project-list">
        {projects.map((project) => (
          <article class="project" id={project.id}>
            <div class="project-period-column">
              <p class="project-period">{project.period}</p>
              {project.tags && project.tags.length > 0 && (
                <div class="project-tags" aria-label="Project classifications">
                  {project.tags.map((tag) => (
                    <span class:list={['project-tag', { 'project-tag-status': tag === 'Ongoing' }]}>
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
            <div>
              <h2>{project.title}</h2>
              {project.titleKorean && <p class="project-title-korean" lang="ko">{project.titleKorean}</p>}
              {(project.funder || project.note) && (
                <p class="project-meta">
                  {project.funder}
                  {project.funder && project.note && (
                    <span aria-hidden="true"> · </span>
                  )}
                  {project.note}
                </p>
              )}
              {project.description && (
                <p class="project-description">{project.description}</p>
              )}
              {project.url && (
                <a class="text-link" href={sitePath(project.url)}>
                  {project.linkLabel || 'Learn more'} <Arrow />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="projects-empty">Details will be added soon.</p>
    )}
  </div>
</Layout>

<style>
  .projects-empty {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .project {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .project:first-child {
    padding-top: 0;
  }
  .project-period {
    color: var(--blue);
    font-size: 0.875rem;
    padding-top: 2px;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 9px;
  }
  .project-tag {
    display: inline-block;
    padding: 3px 7px;
    border-radius: 4px;
    background: #e9f0fa;
    color: #365b8c;
    font-size: 0.625rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .project-tag-status {
    background: #e9f4ee;
    color: #357052;
  }
  .project h2 {
    font-size: 0.9375rem;
    line-height: 1.5;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .project-title-korean {
    color: #6b7787;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.55;
    margin-top: 4px;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .project-meta {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.8;
    margin-top: 6px;
  }
  .project-description {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.8;
    white-space: pre-line;
    overflow-wrap: anywhere;
    max-width: 720px;
    margin-top: 12px;
  }
  .project .text-link {
    margin-top: 16px;
  }
  @media (max-width: 680px) {
    .project {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 24px 0;
    }
    .project-period {
      padding-top: 0;
    }
    .project-tags {
      margin-top: 7px;
    }
  }
</style>
