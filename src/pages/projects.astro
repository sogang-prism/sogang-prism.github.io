---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
import { projects, educationPrograms } from '../data/lab';
import { sitePath } from '../lib/links';
const groups = [
  { id: 'research-projects', title: 'Research Projects', items: projects },
  {
    id: 'education-training-programs',
    title: 'Education & Training Programs',
    items: educationPrograms,
  },
];
---

<Layout title="Projects" active="projects">
  <PageHeading number="04" title="Projects" showDot={false} />
  <div class="page-content">
    {
      groups.map((group) => (
        <section class="project-group" aria-labelledby={group.id}>
          <h2 id={group.id}>{group.title}</h2>
          {group.items.length > 0 ? (
            <div class="project-list">
              {group.items.map((project) => (
                <article class="project" id={project.id}>
                  <p class="project-period">{project.period}</p>
                  <div>
                    <h3>{project.title}</h3>
                    {(project.funder || project.note) && (
                      <p class="project-meta">
                        {project.funder}
                        {project.funder && project.note && (
                          <span aria-hidden="true"> · </span>
                        )}
                        {project.note}
                      </p>
                    )}
                    {project.description && (
                      <p class="project-description">{project.description}</p>
                    )}
                    {project.url && (
                      <a class="text-link" href={sitePath(project.url)}>
                        {project.linkLabel || 'Learn more'} <Arrow />
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="projects-empty">Details will be added soon.</p>
          )}
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .project-group + .project-group {
    margin-top: 48px;
  }
  .project-group > h2 {
    font-size: 1.25rem;
    margin-bottom: 28px;
  }
  .projects-empty {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .project {
    display: grid;
    grid-template-columns: 185px minmax(0, 1fr);
    gap: 36px;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
  }
  .project:first-child {
    padding-top: 0;
  }
  .project-period {
    color: var(--blue);
    font-size: 0.875rem;
    padding-top: 5px;
  }
  .project h3 {
    font-size: 1.125rem;
    overflow-wrap: anywhere;
  }
  .project-meta {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.8;
    margin-top: 12px;
  }
  .project-description {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.8;
    white-space: pre-line;
    overflow-wrap: anywhere;
    max-width: 720px;
    margin-top: 12px;
  }
  .project .text-link {
    margin-top: 16px;
  }
  @media (max-width: 680px) {
    .project {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 24px 0;
    }
    .project-period {
      padding-top: 0;
    }
  }
</style>
