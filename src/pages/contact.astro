---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
import EmailContact from '../components/EmailContact.astro';
import { lab } from '../data/lab';
---

<Layout title="Contact" active="contact">
  <PageHeading
    number="05"
    title="Contact"
    showDot={false}
    description="Get in touch with our lab."
  />
  <div class="page-content contact-layout">
    <dl class="contact-details">
      <div>
        <dt>Email</dt><dd>
          {
            lab.email ? (
              <EmailContact email={lab.email} />
            ) : (
              <span class="muted">Email address to be announced</span>
            )
          }
        </dd>
      </div>

      <div>
        <dt>Affiliation</dt><dd>
          {
            lab.affiliation || (
              <span class="muted">Affiliation to be announced</span>
            )
          }{
            lab.department && (
              <>
                <br />
                {lab.department}
              </>
            )
          }{
            lab.interdisciplinaryProgram && (
              <>
                <br />
                {lab.department && '& '}
                {lab.interdisciplinaryProgram}
              </>
            )
          }
        </dd>
      </div>
      <div>
        <dt>Visit</dt><dd>
          {
            lab.address.length > 0 ? (
              <address>
                {lab.address.map((line) => (
                  <div>{line}</div>
                ))}
              </address>
            ) : (
              <span class="muted">Lab location to be announced</span>
            )
          }{
            lab.mapUrl && (
              <a class="text-link" href={lab.mapUrl}>
                View on map <Arrow external />
              </a>
            )
          }
        </dd>
      </div>
    </dl>
    <aside class="recruitment-note" aria-labelledby="join-title">
      <p class="eyebrow">Open positions</p><h2 id="join-title">Join us</h2>
      <p>
        {
          lab.recruitment ||
            'Information about student opportunities and the application process will be shared here.'
        }
      </p>
      {
        lab.email && (
          <div class="recruitment-email">
            <EmailContact
              email={lab.email}
              subject={lab.name + ' inquiry'}
              compact
            />
          </div>
        )
      }
      {
        lab.draft && !lab.recruitment && (
          <span class="placeholder-label" style="margin-top:20px">
            Recruitment information pending
          </span>
        )
      }
    </aside>
  </div>
</Layout>
