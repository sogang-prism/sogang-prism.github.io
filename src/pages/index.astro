---
import Layout from '../layouts/Layout.astro';
import { lab, research, publications } from '../data/lab';
import { sitePath } from '../lib/links';
import Arrow from '../components/Arrow.astro';
import PublicationItem from '../components/PublicationItem.astro';
import EmptyState from '../components/EmptyState.astro';
const introductionParts = lab.introduction
  .split(/\b(predictive|reliability|interpretability|decision-making)\b/)
  .map((text, index) => ({
    text,
    emphasis: index % 2 === 0 ? [] : text === 'decision-making' ? [4, 9] : [0],
  }));
const recentPapers = [...publications]
  .sort((a, b) => b.year - a.year)
  .slice(0, 3);
---

<Layout>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="accent-line"></span>{
          lab.affiliation || 'Research laboratory'
        }
      </p>
      <h1 id="home-title">
        {lab.name}
      </h1>
      <p class="lab-native-name" lang="ko">{lab.nativeName}</p>
      <p class="hero-tagline">{lab.tagline}</p>
      <p class="hero-introduction">
        {
          introductionParts.map(({ text, emphasis }) =>
            emphasis.length === 0
              ? text
              : Array.from(text).map((letter, index) =>
                  emphasis.includes(index) ? (
                    <strong class="prism-letter">{letter}</strong>
                  ) : (
                    letter
                  ),
                ),
          )
        }
      </p>
      {
        lab.draft && (
          <span class="placeholder-label">Introduction placeholder</span>
        )
      }
      <a class="text-link hero-link" href={sitePath('research/')}
        >Explore our research <Arrow /></a
      >
    </div>
    <aside class="hero-index" aria-label="Explore the lab">
      <span class="eyebrow index-label">Inside the lab</span>
      <a href={sitePath('research/')}
        ><span class="index-number">01</span><div>
          <strong>Research</strong><span>Questions & directions</span>
        </div><Arrow /></a
      >
      <a href={sitePath('people/')}
        ><span class="index-number">02</span><div>
          <strong>People</strong><span>The people behind the work</span>
        </div><Arrow /></a
      >
      <a href={sitePath('publications/')}
        ><span class="index-number">03</span><div>
          <strong>Publications</strong><span>Papers & shared knowledge</span>
        </div><Arrow /></a
      >
      <a href={sitePath('projects/')}>
        <span class="index-number">04</span>
        <div><strong>Projects</strong><span>Research in practice</span></div>
        <Arrow />
      </a>
    </aside>
  </section>

  <section
    class="home-section research-section"
    aria-labelledby="research-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Research areas</p><h2 id="research-title">
          Research themes
        </h2>
      </div><a class="text-link" href={sitePath('research/')}
        >View research <Arrow /></a
      >
    </div>
    {
      research.length > 0 ? (
        <div class="research-grid">
          {research.slice(0, 3).map((theme, index) => (
            <a class="research-card" href={sitePath(`research/#${theme.id}`)}>
              <span class="theme-number">0{index + 1}</span>
              <h3>{theme.title}</h3>
              <p>{theme.summary}</p>
              <span class="card-arrow">
                <Arrow />
              </span>
            </a>
          ))}
        </div>
      ) : lab.draft ? (
        <div class="research-grid">
          {[1, 2, 3].map((number) => (
            <div class="research-card placeholder-card">
              <span class="theme-number">0{number}</span>
              <h3>Research theme {String(number).padStart(2, '0')}</h3>
              <p>Research topic and a brief description will appear here.</p>
              <span class="placeholder-label">Placeholder</span>
            </div>
          ))}
        </div>
      ) : (
        <EmptyState title="Research themes coming soon" />
      )
    }
  </section>

  <section
    class="home-section publications-section"
    aria-labelledby="papers-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / Recent work</p><h2 id="papers-title">
          Publications
        </h2>
      </div><a class="text-link" href={sitePath('publications/')}
        >All publications <Arrow /></a
      >
    </div>
    {
      recentPapers.length > 0 ? (
        <div class="publication-list">
          {recentPapers.map((paper) => (
            <PublicationItem paper={paper} />
          ))}
        </div>
      ) : lab.draft ? (
        <div class="publication placeholder-publication">
          <>
            <span class="publication-year">Year</span>
            <div class="publication-body">
              <>
                <span class="placeholder-label">Publication placeholder</span>
                <h3>Title of a publication</h3>
                <p class="publication-authors">Author names</p>
                <p class="publication-venue">
                  Journal or conference · Publication details
                </p>
              </>
            </div>
          </>
        </div>
      ) : (
        <EmptyState title="Publications coming soon" />
      )
    }
  </section>
</Layout>
